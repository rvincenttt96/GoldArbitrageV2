from config.settings import MIN_NET_PROFIT


class Executor:

    def __init__(self, risk_manager):
        self.risk_manager = risk_manager


    def _response_ok(self, response):

        if response is None:
            return False

        if not isinstance(response, dict):
            return False

        if "success" in response:
            return response.get("success") is True

        if "code" in response:

            if response.get("code") != 0:
                return False

            data = response.get("data")

            if isinstance(data, dict):

                invoice_status = data.get(
                    "invoiceStatus"
                )

                if invoice_status is not None:

                    return str(
                        invoice_status
                    ).upper() in {
                        "DONE",
                        "FINISHED",
                        "SUCCESS",
                        "COMPLETED"
                    }

            return True

        if "status" in response:

            status = str(
                response.get("status")
            ).lower()

            return status in {
                "success",
                "successful",
                "done",
                "finished",
                "completed",
                "ok"
            }

        if response.get("error"):
            return False

        if response.get("errors"):
            return False

        # Some APIs return a successful result
        # without a standard status field.
        return True


    def _estimate_current_net(
        self,
        opportunity,
        current_buy_price,
        current_sell_price
    ):

        amount = opportunity.amount

        if opportunity.buy_price:

            current_buy_fee = (
                opportunity.buy_fee
                *
                current_buy_price
                /
                opportunity.buy_price
            )

        else:
            current_buy_fee = opportunity.buy_fee


        if opportunity.sell_price:

            current_sell_fee = (
                opportunity.sell_fee
                *
                current_sell_price
                /
                opportunity.sell_price
            )

        else:
            current_sell_fee = opportunity.sell_fee


        buy_value = (
            current_buy_price
            *
            amount
        )

        sell_value = (
            current_sell_price
            *
            amount
        )


        current_net = (
            sell_value
            -
            current_sell_fee
            -
            buy_value
            -
            current_buy_fee
        )


        return current_net


    def execute(
        self,
        opportunity,
        buy_exchange,
        sell_exchange,
        buy_portfolio,
        sell_portfolio
    ):

        approved = self.risk_manager.check(
            opportunity,
            buy_portfolio,
            sell_portfolio
        )

        if not approved:

            return {
                "status": "rejected",
                "reason": "risk_check_failed"
            }


        # Pre-flight:
        # make sure both APIs respond before sending money.
        try:

            current_buy_quote = (
                buy_exchange.get_price("buy")
            )

            current_sell_quote = (
                sell_exchange.get_price("sell")
            )

        except Exception as e:

            return {
                "status": "rejected",
                "reason": "preflight_failed",
                "error": repr(e)
            }


        current_net = self._estimate_current_net(
            opportunity,
            current_buy_quote.price,
            current_sell_quote.price
        )


        if current_net < MIN_NET_PROFIT:

            return {
                "status": "rejected",
                "reason": "price_moved",
                "current_buy_price": current_buy_quote.price,
                "current_sell_price": current_sell_quote.price,
                "estimated_net_profit": current_net
            }


        # BUY LEG
        try:

            buy_order = buy_exchange.buy(
                opportunity.amount
            )

        except Exception as e:

            # A network exception after POST is ambiguous:
            # the exchange may have processed the order.
            return {
                "status": "execution_uncertain",
                "stage": "buy",
                "halt_required": True,
                "error": repr(e)
            }


        if not self._response_ok(
            buy_order
        ):

            return {
                "status": "failed",
                "stage": "buy",
                "reason": "buy_not_confirmed",
                "buy_order": buy_order
            }


        # SELL LEG
        try:

            sell_order = sell_exchange.sell(
                opportunity.amount
            )

        except Exception as e:

            return {
                "status": "partial_execution",
                "stage": "sell",
                "halt_required": True,
                "buy_order": buy_order,
                "error": repr(e)
            }


        if not self._response_ok(
            sell_order
        ):

            return {
                "status": "partial_execution",
                "stage": "sell",
                "halt_required": True,
                "buy_order": buy_order,
                "sell_order": sell_order,
                "reason": "sell_not_confirmed"
            }


        return {
            "status": "completed",
            "current_buy_price": current_buy_quote.price,
            "current_sell_price": current_sell_quote.price,
            "estimated_net_profit": current_net,
            "buy_order": buy_order,
            "sell_order": sell_order
        }
